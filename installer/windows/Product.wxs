<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Reverse.Local"
           Language="1033"
           Version="1.2.0.0"
           Manufacturer="Hansen Dusenov"
           UpgradeCode="8F9E4A2D-7B3C-4E1A-9D5F-2C6B8A1E3F40">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="Reverse.Local - Local Reverse Proxy, Native SSH Tunnel &amp; LAN DNS Broadcaster" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Reverse.Local Core Daemon" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ReverseLocal" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="3D7A91E0-5A2F-4C9B-8E11-7C3F6A209B14" Win64="yes">
        <File Id="ReverseLocalExe" Source="..\..\reverse-local.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcuts" Guid="A41C8E19-62D4-4781-9B10-5E9C32A41F08">
        <Shortcut Id="StartMenuShortcut"
                  Name="Reverse.Local"
                  Description="Reverse.Local Control Panel &amp; Proxy Daemon"
                  Target="[INSTALLFOLDER]reverse-local.exe"
                  Arguments="-control"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Reverse.Local"
                  Description="Reverse.Local Control Panel &amp; Proxy Daemon"
                  Target="[INSTALLFOLDER]reverse-local.exe"
                  Arguments="-control"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ReverseLocal" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>

